{
  "name": "la-ultima-llama",
  "version": "0.2.0",
  "description": "Dungeon crawler RPG por casillas con estética de grabado y dithering",
  "main": "main.js",
  "private": true,
  "scripts": {
    "web": "python tools/servidor.py",
    "start": "electron .",
    "prueba": "electron . --prueba",
    "dist": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.laultimallama.game",
    "productName": "La Ultima Llama",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "ipc.js",
      "css/**",
      "js/**",
      "assets/**"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
