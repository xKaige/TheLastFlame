{
  "name": "la-ultima-llama",
  "version": "0.3.1",
  "description": "Dungeon crawler de grupo por turnos con estética de dithering y pocos colores",
  "main": "main.js",
  "private": true,
  "scripts": {
    "web": "python tools/servidor.py",
    "start": "electron .",
    "prueba": "electron . --prueba",
    "dist": "electron-builder --win --dir",
    "simular": "node tools/simular.js 1000"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.laultimallama.game",
    "productName": "La Ultima Llama",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "ipc.js",
      "css/**",
      "js/**",
      "assets/**",
      "datos/**",
      "interfaz/**",
      "!assets/musica/*.mp3"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
