  "silla_del_rey": {
    "titulo": "La silla del rey",
    "texto": "A la cabecera de un salón vacío, una silla alta. Tu sombra se sienta antes que vos. «Dale. Todos se sentaron alguna vez. Desde acá se ve todo».",
    "piso": 2,
    "mapa": "mazmorra/salones/accesorios/silla_rota",
    "escala": 0.65,
    "opciones": [
      {
        "texto": "Sentarse",
        "sub": "Te lo va a cobrar.",
        "exito": {
          "texto": "«Eso.» Por un momento el salón está lleno, y todos te obedecen. Al pararte, tenés algo en la mano. Lo va a cobrar.",
          "efectos": [
            {
              "tipo": "objeto"
            },
            {
              "tipo": "ceniza",
              "valor": 10
            },
            {
              "tipo": "trato"
            }
          ]
        }
      },
      {
        "texto": "Romperla a golpes",
        "requisito": {
          "fue": 13
        },
        "exito": {
          "texto": "La madera grita como no debería. Tu sombra vuelve a tus pies, y se queda quieta un buen rato.",
          "efectos": [
            {
              "tipo": "impetu",
              "valor": 2
            },
            {
              "tipo": "sangre",
              "valor": 0.1
            }
          ]
        }
      },
      {
        "texto": "Quedarse de pie",
        "exito": {
          "texto": "«Aldemar dijo lo mismo. Duró más que vos, seguro.»",
          "efectos": []
        }
      }
    ]
  }
